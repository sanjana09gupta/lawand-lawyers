# Server-only configuration for the signed Google Apps Script receiver.
# Do not prefix these values with VITE_. Never expose APPS_SCRIPT_WEBHOOK_SECRET in browser code.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
APPS_SCRIPT_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Comma-separated public website origins allowed to use the Vercel API.
ALLOWED_QUOTE_ORIGINS=https://lawandlawyers.co.uk,https://www.lawandlawyers.co.uk
# Public Vercel API location. Required when the static frontend is hosted on IONOS.
VITE_API_BASE_URL=https://law-and-lawyers-two.vercel.app
# The OpenAI API key belongs in Apps Script Script Properties, not here.
